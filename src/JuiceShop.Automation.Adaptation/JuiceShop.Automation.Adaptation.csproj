<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADAPTATION — ISTQB CTAL-TAE 2016 section 3.1.5 / v2.0 section 3.1.1 "test adaptation".
    Mediates between technology-neutral test definitions and the specific technology of the SUT.

    This is the ONLY project in the solution permitted to reference Microsoft.Playwright.
    JuiceShop.Automation.Definition.Architecture.ArchitectureTests enforces that at build time,
    and it is why IBrowserSession exposes tracing/screenshot capture in technology-free terms:
    the Execution layer needs those capabilities but must not learn what a browser is.
  -->

  <PropertyGroup>
    <RootNamespace>JuiceShop.Automation.Adaptation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JuiceShop.Automation.Utility\JuiceShop.Automation.Utility.csproj" />
  </ItemGroup>

</Project>
