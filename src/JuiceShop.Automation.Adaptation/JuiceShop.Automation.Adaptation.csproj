<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADAPTATION — everything outside the test system: services, protocols, databases, integrations.

    Small in a UI-driven suite: the only non-browser channel is the HTTP readiness probe. A separate
    project rather than a folder because it is the seam that grows — an API client or database
    fixture belongs here, and neither should touch the driver, the flows or the tests.

    Implements ports declared in Utility; bound at the composition root in Execution.
  -->

  <PropertyGroup>
    <RootNamespace>JuiceShop.Automation.Adaptation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JuiceShop.Automation.Utility\JuiceShop.Automation.Utility.csproj" />
  </ItemGroup>

</Project>
