<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EXECUTION — ISTQB CTAL-TAE 2016 section 3.1.4.

    Note this layer is deliberately more than "the test runner". Section 3.1.4 also requires
    setting up and tearing down the SUT, configuring and parameterising the test setup,
    instrumenting for filtered logging, and validating/collecting results — none of which NUnit
    provides. That is what SutReadinessGate, GlobalSetup and ArtifactCollector are.

    No Microsoft.Playwright reference here: artifact capture goes through the technology-free
    IBrowserSession contract from the Adaptation layer.
  -->

  <PropertyGroup>
    <RootNamespace>JuiceShop.Automation.Execution</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" />
    <PackageReference Include="Allure.NUnit" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JuiceShop.Automation.Adaptation\JuiceShop.Automation.Adaptation.csproj" />
    <ProjectReference Include="..\JuiceShop.Automation.Utility\JuiceShop.Automation.Utility.csproj" />
  </ItemGroup>

</Project>
