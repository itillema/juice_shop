<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UTILITY — the test automation framework itself.

    Configuration, logging, dependency-injection wiring, reporting and artifact capture, the run
    lifecycle, the Playwright driver, and the base classes the test cases inherit from.

    This project has NO ProjectReference to any other layer, by design. It is the bottom of the
    dependency graph, contains nothing specific to Juice Shop, and could be lifted into another
    product's solution unchanged.

    Where the framework needs something from an integration — the run lifecycle has to wait for the
    SUT to be reachable — it declares the port here (Sut/ISutReadinessGate.cs) and lets the
    Adaptation layer supply the adapter. That is what keeps this project free of a dependency on
    Adaptation without giving up ownership of the run lifecycle.
  -->

  <PropertyGroup>
    <RootNamespace>JuiceShop.Automation.Utility</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Allure.NUnit" />
    <!-- NUnit for TestContext (log sink, artifact naming) and the [SetUp]/[TearDown] base class. -->
    <PackageReference Include="NUnit" />
  </ItemGroup>

</Project>
