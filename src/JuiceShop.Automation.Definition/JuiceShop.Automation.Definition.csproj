<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DEFINITION — what the SUT is and how a business action is performed against it:
    page objects, flows, and test data.

    This is the layer that changes when the application changes. A relocated button is a page-object
    edit; a new step in checkout is a flow edit; neither reaches the test cases.

    Page objects and their contracts are internal to this assembly. Only the flows and the test data
    are public, so a test case physically cannot reach a locator — the compiler stops it, with no
    architecture rule needed.
  -->

  <PropertyGroup>
    <RootNamespace>JuiceShop.Automation.Definition</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Page objects drive the browser through the Utility layer's Playwright session. -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Bogus" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JuiceShop.Automation.Utility\JuiceShop.Automation.Utility.csproj" />
  </ItemGroup>

</Project>
