<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DEFINITION — what the SUT is and how a business action is performed: pages, flows, test data.

    The layer that changes when the application does. A relocated button is a page-object edit, a
    new checkout step is a flow edit; neither reaches the test cases.

    Page objects and contracts are internal, so the compiler — not a rule — stops a test case
    reaching a locator.
  -->

  <PropertyGroup>
    <RootNamespace>JuiceShop.Automation.Definition</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Page objects drive the browser through the Utility layer's Playwright session. -->
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Bogus" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JuiceShop.Automation.Utility\JuiceShop.Automation.Utility.csproj" />
  </ItemGroup>

</Project>
