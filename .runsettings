<?xml version="1.0" encoding="utf-8"?>
<RunSettings>

  <!-- No <Playwright> section: browser config lives in appsettings.json. See ADR-0002. -->

  <RunConfiguration>
    <ResultsDirectory>artifacts/test-results</ResultsDirectory>
  </RunConfiguration>

  <NUnit>
    <!-- Fixtures parallel, tests within a fixture sequential. Never ParallelScope.Children. -->
    <NumberOfTestWorkers>4</NumberOfTestWorkers>
    <DefaultTestNamePattern>{m}{a}</DefaultTestNamePattern>
  </NUnit>

</RunSettings>
