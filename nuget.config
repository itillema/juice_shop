<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    A single, explicitly cleared source. Central Package Management emits NU1507 when more than
    one source is configured, and an inherited machine-level source would make restore
    non-reproducible across contributors.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
